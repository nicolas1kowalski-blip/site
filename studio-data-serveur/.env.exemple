# Copier en .env puis charger avec : set -a; . ./.env; set +a   (ou exporter les variables dans le service systemd)
SD_HOTE=127.0.0.1            # 0.0.0.0 pour écouter sur toutes les interfaces (derrière un reverse proxy TLS)
SD_PORT=8420
SD_DONNEES=./donnees          # base DuckDB, fichiers déposés, documents JSON (à sauvegarder)
SD_DUCKDB_THREADS=            # vide = tous les cœurs
SD_DUCKDB_MEMOIRE=            # ex. 8GB ; vide = 80 % de la RAM
SD_LIMITE_LIGNES=1000000      # lignes maximales d'une réponse POST /api/sql
SD_TAILLE_MAX_FICHIER_MO=4096
SD_AUTH_MODE=aucune           # seul mode disponible aujourd'hui
SD_JOURNAL=info               # info | warn | error | silent
