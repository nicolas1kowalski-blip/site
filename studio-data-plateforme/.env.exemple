# Copier en .env (lu par docker compose) — ou exporter ces variables pour un lancement sans Docker.

# ---- Docker compose ----
POSTGRES_PASSWORD=changez-moi
SD_DOMAINE=localhost                # ex. studio-data.exemple.fr (Caddy obtient le certificat tout seul)

# ---- API (variables SD_*, lues par api/src/configuration/configuration.ts) ----
SD_ADMIN_IDENTIFIANT=admin
SD_ADMIN_MOT_DE_PASSE=changez-moi   # créé au premier démarrage uniquement ; à changer ensuite dans « Mon compte »
SD_HOTE=127.0.0.1                   # 0.0.0.0 dans Docker
SD_PORT=8430
SD_DONNEES=./donnees                # bases DuckDB et fichiers déposés (à sauvegarder)
SD_POSTGRES_URL=                    # postgres://studio:motdepasse@localhost:5432/studio_data ; vide = PGlite (développement)
SD_DUCKDB_THREADS=                  # vide = tous les cœurs
SD_DUCKDB_MEMOIRE=                  # ex. 8GB ; vide = 80 % de la RAM
SD_LIMITE_LIGNES=1000000
SD_TAILLE_MAX_FICHIER_MO=4096
SD_SESSION_DUREE_HEURES=12
SD_COOKIE_SECURISE=false            # true derrière HTTPS
SD_JOURNAL=info                     # debug | info | warn | error | silent
