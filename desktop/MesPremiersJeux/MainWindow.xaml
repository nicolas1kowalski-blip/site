<Window x:Class="MesPremiersJeux.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eyzi" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen" Background="#FFF3E9FF"
        FontFamily="./Fonts/#Fredoka One, Segoe UI, Segoe UI Emoji">
    <Grid x:Name="RootGrid">
        <DockPanel>
            <!-- Barre d'onglets (masquée pendant une activité pour gagner de la place) -->
            <Border x:Name="TopBar" DockPanel.Dock="Top" Padding="14,12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFB388FF" Offset="0" />
                        <GradientStop Color="#FF8AD6FF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Le porte-monnaie d'étoiles OUVRE LA BOUTIQUE (cliquable au regard). -->
                        <Button x:Name="StarsBtn" Style="{StaticResource TabButton}" MinWidth="110"
                                Margin="6,0" Click="Shop_Click">
                            <TextBlock x:Name="StarsText" Foreground="White" FontSize="18" FontWeight="Bold" />
                        </Button>
                        <TextBlock x:Name="GazeStatus" VerticalAlignment="Center"
                                   Foreground="White" FontSize="14" Margin="12,0" />
                        <Button x:Name="FullscreenBtn" Style="{StaticResource TabButton}"
                                Content="⛶" FontSize="26" MinWidth="60" Margin="6,0" Click="Fullscreen_Click" />
                        <Button x:Name="SettingsBtn" Style="{StaticResource TabButton}"
                                Content="⚙" FontSize="26" MinWidth="60" Margin="6,0" Click="Settings_Click" />
                    </StackPanel>
                    <!-- Les onglets se RÉDUISENT si la place manque (Viewbox) :
                         « Musique » ne peut plus disparaître hors de l'écran. -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                             HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="TabAccueil" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="accueil">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠  " FontSize="24" /><TextBlock Text="Accueil" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabStories" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="stories">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📖  " FontSize="24" /><TextBlock Text="Histoires" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabGames" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="games">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎮  " FontSize="24" /><TextBlock Text="Jeux" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabEdu" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="edu">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎓  " FontSize="24" /><TextBlock Text="Éducatif" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabColoring" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="coloring">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎨  " FontSize="24" /><TextBlock Text="Coloriage" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabMusic" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="music">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎵  " FontSize="24" /><TextBlock Text="Musique" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabParcours" Style="{StaticResource TabButton}" Click="Parcours_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅  " FontSize="24" /><TextBlock Text="Parcours" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </Viewbox>
                </DockPanel>
            </Border>

            <!-- Contenu de l'onglet actif -->
            <Grid x:Name="ContentHost" />
        </DockPanel>

        <!-- Panneau de réglages (parent) -->
        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsBtn}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" CornerRadius="14" Padding="18" Margin="8"
                    BorderBrush="#FFB388FF" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
                <StackPanel Width="320">
                    <TextBlock Text="Réglages" FontSize="20" FontWeight="Bold"
                               Foreground="#FF3B2A5A" Margin="0,0,0,12" />
                    <CheckBox x:Name="GazeModeCheck" Content="Piloter au regard (dwell)"
                              FontSize="15" Checked="GazeMode_Changed" Unchecked="GazeMode_Changed" />
                    <TextBlock Text="🎛 Source du regard (pilote)" FontSize="14" FontWeight="Bold"
                               Foreground="#FF6B5B8A" Margin="0,10,0,2" />
                    <ComboBox x:Name="DriverCombo" FontSize="14" Padding="6,6"
                              SelectionChanged="Driver_Changed">
                        <ComboBoxItem Tag="auto" Content="🤖 Auto — direct si possible, sinon repli" />
                        <ComboBoxItem Tag="direct" Content="👁 Regard direct (Tobii Experience)" />
                        <ComboBoxItem Tag="stream" Content="⚡ Moteur Tobii direct (comme Grid 3)" />
                        <ComboBoxItem Tag="streamA" Content="⚡ Moteur Tobii direct — version de l'application" />
                        <ComboBoxItem Tag="pro" Content="🔬 Pro SDK (Tobii.Research)" />
                        <ComboBoxItem Tag="curseur" Content="🖱 Curseur (TD Control — tout appareil)" />
                    </ComboBox>
                    <TextBlock x:Name="DriverStatus" Text="…" FontSize="12" Foreground="#FF9A8AB8"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="Le pilote change à chaud, sans redémarrer. « Curseur » marche avec toute commande oculaire qui déplace la souris."
                               FontSize="12" Foreground="#FF9A8AB8" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <Button Content="👁 Vérifier la position des yeux" FontSize="14" Padding="8,8"
                            Margin="0,8,0,0" Click="EyeTrack_Click" />
                    <Button Content="🎯 Calibrer la tablette (logiciel Tobii, sans TD Control)" FontSize="14" Padding="8,8"
                            Margin="0,6,0,0" Click="DeviceCalib_Click" />
                    <Button Content="⭐ Réglage éclair (3 s, 1 étoile)" FontSize="14" Padding="8,8"
                            Margin="0,6,0,0" Click="QuickFix_Click" />
                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <Button Content="🎯 Régler la précision (étoile)…" FontSize="14" Padding="8,8"
                                Margin="0,0,4,0" Click="Calibrate_Click" />
                        <Button Content="↺ Annuler la correction" FontSize="14" Padding="8,8"
                                Margin="4,0,0,0" Click="ClearBias_Click" />
                    </UniformGrid>
                    <Button Content="🙋 Je choisis (2 à 4 images, elle regarde celle qu'elle veut)" FontSize="14" Padding="8,8"
                            Margin="0,10,0,0" Click="Choice_Click" />
                    <Button Content="📊 Bilan de la session…" FontSize="14" Padding="8,8"
                            Margin="0,6,0,0" Click="Session_Click" />
                    <Button Content="🧾 Ouvrir le journal (diagnostic)" FontSize="14" Padding="8,8"
                            Margin="0,6,0,0" Click="OpenLog_Click" />
                    <Button Content="🔎 Rapport du regard (comparer deux tablettes)" FontSize="14" Padding="8,8"
                            Margin="0,6,0,0" Click="GazeReport_Click" />
                    <CheckBox x:Name="AdminCheck" Content="🔧 Mode administration (regard en pause)"
                              FontSize="15" Margin="0,8,0,0"
                              Checked="GazeMode_Changed" Unchecked="GazeMode_Changed" />
                    <TextBlock Text="En mode admin : ajouter / modifier / supprimer les livres, les coloriages et les photos."
                               FontSize="12" Foreground="#FF9A8AB8" TextWrapping="Wrap" Margin="24,2,0,0" />
                    <Button Content="👨‍👩‍👧 Gérer les photos de famille…" FontSize="14" Padding="8,8"
                            Margin="0,10,0,0" Click="FamilyManager_Click" />
                    <Separator Margin="0,12,0,8" />
                    <TextBlock Text="🔑 Licence et mises à jour" FontSize="14" FontWeight="Bold" Foreground="#FF6B5B8A" Margin="0,0,0,2" />
                    <TextBlock x:Name="LicenceText" FontSize="12" Foreground="#FF9A8AB8" TextWrapping="Wrap" />
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="#FF9A8AB8" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <Button Content="🔄 Vérifier les mises à jour" FontSize="14" Padding="8,8" Margin="0,0,4,0" Click="CheckUpdate_Click" />
                        <Button Content="↩ Version précédente" FontSize="14" Padding="8,8" Margin="4,0,0,0" Click="Rollback_Click" />
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <Button Content="🔑 Changer la licence…" FontSize="14" Padding="8,8" Margin="0,0,4,0" Click="Licence_Click" />
                        <Button Content="🚫 Libérer cette tablette" FontSize="14" Padding="8,8" Margin="4,0,0,0" Click="ReleaseTablet_Click" />
                    </UniformGrid>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FF9A8AB8" Margin="0,4,0,0"
                               Text="Changement de poste : « Libérer » rend la place de cette tablette à la famille (la licence est limitée à un nombre de tablettes), et l'application redemandera une licence. L'éditeur peut aussi désactiver une tablette à distance." />
                    <Separator Margin="0,12,0,8" />
                    <TextBlock Text="👧 Prénom de l'enfant (activité « Mon prénom »)" FontSize="14"
                               Foreground="#FF6B5B8A" Margin="0,12,0,2" />
                    <TextBox x:Name="ChildNameBox" FontSize="14" Padding="6,4" LostFocus="ChildName_Changed" />
                    <TextBlock Text="🎚 Niveau des jeux" FontSize="14" FontWeight="Bold" Foreground="#FF6B5B8A" Margin="0,10,0,2" />
                    <ComboBox x:Name="LevelCombo" FontSize="14" Padding="6,6" SelectionChanged="Level_Changed">
                        <ComboBoxItem Tag="auto" Content="🤖 Automatique — monte quand elle réussit" />
                        <ComboBoxItem Tag="1" Content="🌱 Petite section — 2 choix, nombres jusqu'à 5" />
                        <ComboBoxItem Tag="2" Content="🌿 Moyenne section — 3 choix, jusqu'à 7" />
                        <ComboBoxItem Tag="3" Content="🌳 Grande section · CP — 4 choix, jusqu'à 10" />
                    </ComboBox>
                    <TextBlock x:Name="LevelStatus" FontSize="12" Foreground="#FF9A8AB8" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="⏱ Proposer une pause après (minutes de jeu)" FontSize="14" FontWeight="Bold" Foreground="#FF6B5B8A" Margin="0,10,0,2" />
                    <ComboBox x:Name="SessionCombo" FontSize="14" Padding="6,6" SelectionChanged="Session_Changed">
                        <ComboBoxItem Tag="0" Content="Jamais" />
                        <ComboBoxItem Tag="5" Content="5 minutes" />
                        <ComboBoxItem Tag="10" Content="10 minutes" />
                        <ComboBoxItem Tag="15" Content="15 minutes" />
                        <ComboBoxItem Tag="20" Content="20 minutes" />
                    </ComboBox>
                    <TextBlock Text="🎙 Vos voix (bravo de papa/maman)" FontSize="14" FontWeight="Bold" Foreground="#FF6B5B8A" Margin="0,12,0,2" />
                    <Button Content="🎙  Enregistrer vos voix" FontSize="14" Padding="8,8" Margin="0,4,0,0" Click="RecordVoices_Click" />
                    <Button Content="📊  Bilan (semaine, niveaux, étoiles)" FontSize="14" Padding="8,8" Margin="0,6,0,0" Click="Bilan_Click" />
                    <CheckBox x:Name="CommBtnCheck" Content="💬 Bouton « Parler » toujours visible" FontSize="14"
                              Margin="0,10,0,0" Checked="CommBtn_Changed" Unchecked="CommBtn_Changed" />
                    <CheckBox x:Name="YesNoCheck" Content="✅ Boutons « Oui / Non » toujours visibles" FontSize="14"
                              Margin="0,6,0,0" Checked="YesNo_Changed" Unchecked="YesNo_Changed" />
                    <CheckBox x:Name="AutoDwellCheck" Content="👁 Ajuster tout seul le temps de fixation" FontSize="14"
                              Margin="0,6,0,0" Checked="AutoDwell_Changed" Unchecked="AutoDwell_Changed" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FF9A8AB8" Margin="0,4,0,0"
                               Text="Enregistrez des « Bravo ! » et un « Bonjour ! » avec votre voix : l'application les joue aux moments forts, à la place de la voix de synthèse." />

                    <TextBlock Text="📁 Le contenu de la famille" FontSize="14" FontWeight="Bold" Foreground="#FF6B5B8A" Margin="0,12,0,2" />
                    <TextBlock x:Name="ContentDirInfo" TextWrapping="Wrap" FontSize="12" Foreground="#FF9A8AB8" Margin="0,2,0,0" />
                    <Button Content="📂 Ouvrir le dossier du contenu" FontSize="14" Padding="8,8" Click="OpenContent_Click" />
                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <Button Content="📦 Exporter…" FontSize="14" Padding="8,8" Margin="0,0,4,0" Click="ExportContent_Click" />
                        <Button Content="📥 Importer…" FontSize="14" Padding="8,8" Margin="4,0,0,0" Click="ImportContent_Click" />
                    </UniformGrid>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FF9A8AB8" Margin="0,4,0,0"
                               Text="Photos, voix, livres, coloriages et images ajoutées vivent sur cette tablette, dans le dossier de l'application. « Exporter » fait un seul fichier (sauvegarde, ou copie vers une autre tablette avec « Importer »)." />

                    <TextBlock Text="☁️ Le nuage de l'application (serveur)" FontSize="14" FontWeight="Bold" Foreground="#FF6B5B8A" Margin="0,12,0,2" />
                    <TextBlock Text="URL du projet :" FontSize="13" Foreground="#FF9A8AB8" Margin="0,4,0,2" />
                    <TextBox x:Name="SupabaseUrlBox" FontSize="13" Padding="6,4" LostFocus="Supabase_Changed" />
                    <TextBlock Text="Clé :" FontSize="13" Foreground="#FF9A8AB8" Margin="0,6,0,2" />
                    <TextBox x:Name="SupabaseKeyBox" FontSize="13" Padding="6,4" LostFocus="Supabase_Changed" />
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Button x:Name="CloudUpBtn" Content="☁️⬆ Envoyer maintenant" FontSize="14" Padding="8,8" Margin="0,0,4,0" Click="CloudUp_Click" />
                        <Button x:Name="CloudDownBtn" Content="☁️⬇ Récupérer maintenant" FontSize="14" Padding="8,8" Margin="4,0,0,0" Click="CloudDown_Click" />
                    </UniformGrid>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FF9A8AB8" Margin="0,4,0,0"
                               Text="Le contenu de la famille est synchronisé entre vos tablettes par l'application, chiffré avec votre mot de passe famille (jamais lisible par personne d'autre). Automatique : récupéré au démarrage s'il y a du nouveau, envoyé à la fermeture si vous avez ajouté des choses." />
                    <TextBlock x:Name="CloudStatusText" FontSize="12" Foreground="#FF6B5B8A" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="Durée de fixation" FontSize="14" Foreground="#FF6B5B8A" Margin="0,14,0,2" />
                    <Slider x:Name="DwellSlider" Minimum="400" Maximum="2500" TickFrequency="100"
                            IsSnapToTickEnabled="True" ValueChanged="DwellSlider_Changed" />
                    <TextBlock x:Name="DwellValue" FontSize="13" Foreground="#FF6B5B8A" HorizontalAlignment="Right" />

                    <TextBlock Text="Lissage (stabilité du regard)" FontSize="14" Foreground="#FF6B5B8A" Margin="0,14,0,2" />
                    <Slider x:Name="SmoothSlider" Minimum="0" Maximum="100" ValueChanged="SmoothSlider_Changed" />
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="réactif" DockPanel.Dock="Left" FontSize="12" Foreground="#FF9A8AB8" />
                        <TextBlock Text="très stable" DockPanel.Dock="Right" FontSize="12" Foreground="#FF9A8AB8" />
                    </DockPanel>

                    <TextBlock Text="Taille du cercle" FontSize="14" Foreground="#FF6B5B8A" Margin="0,12,0,2" />
                    <Slider x:Name="CircleSlider" Minimum="60" Maximum="170" ValueChanged="CircleSlider_Changed" />

                    <Separator Margin="0,14,0,10" />
                    <TextBlock Text="Voix Windows (hors ligne)" FontSize="14" Foreground="#FF6B5B8A" Margin="0,0,0,2" />
                    <ComboBox x:Name="VoiceCombo" FontSize="14" SelectionChanged="Voice_Changed" />
                    <TextBlock Text="Hauteur de la voix (aiguë = plus enfantine)" FontSize="14" Foreground="#FF6B5B8A" Margin="0,10,0,2" />
                    <Slider x:Name="PitchSlider" Minimum="-20" Maximum="60" ValueChanged="Pitch_Changed" />

                    <Separator Margin="0,14,0,10" />
                    <TextBlock Text="🌟 Voix naturelle (Azure, en ligne)" FontSize="14" FontWeight="Bold" Foreground="#FF6B5B8A" Margin="0,0,0,2" />
                    <TextBlock Text="Clé Azure Speech :" FontSize="13" Foreground="#FF9A8AB8" Margin="0,4,0,2" />
                    <TextBox x:Name="AzureKeyBox" FontSize="13" Padding="6,4" LostFocus="Azure_Changed" />
                    <TextBlock Text="Région :" FontSize="13" Foreground="#FF9A8AB8" Margin="0,6,0,2" />
                    <TextBox x:Name="AzureRegionBox" FontSize="13" Padding="6,4" LostFocus="Azure_Changed" />
                    <TextBlock Text="Voix :" FontSize="13" Foreground="#FF9A8AB8" Margin="0,6,0,2" />
                    <ComboBox x:Name="AzureVoiceCombo" FontSize="13" SelectionChanged="Azure_Changed" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FF9A8AB8" Margin="0,6,0,0"
                               Text="Sans clé : voix Windows. Avec clé : voix naturelle (Eloise = voix d'enfant). Repli automatique hors ligne." />
                    <TextBlock x:Name="EnglishVoiceText" TextWrapping="Wrap" FontSize="12" Foreground="#FF9A8AB8" Margin="0,4,0,0" />

                    <Button Content="🔈 Écouter un exemple" FontSize="14" Padding="8,6" Margin="0,10,0,0" Click="VoiceTest_Click" />

                    <Border Background="#FFF3E9FF" CornerRadius="10" Padding="10" Margin="0,14,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#FF5A4A7A"
                                   Text="Calibrage : « 🎯 Calibrer la tablette » ouvre le calibrage Tobii installé (TD I-13, PCEye 5…). Active le mode « Contrôle de l'ordinateur » pour que le regard déplace le curseur, puis coche « Piloter au regard » ci-dessus." />
                    </Border>

                    <Separator Margin="0,14,0,10" />
                    <TextBlock Text="Fenêtre" FontSize="14" Foreground="#FF6B5B8A" Margin="0,0,0,6" />
                    <UniformGrid Columns="3">
                        <Button Content="⛶ Plein écran" Padding="6,10" Margin="0,0,6,0" FontSize="14" Click="Fullscreen_Click" />
                        <Button Content="🗕 Réduire" Padding="6,10" Margin="0,0,6,0" FontSize="14" Click="Minimize_Click" />
                        <Button Content="✕ Fermer" Padding="6,10" FontSize="14" Foreground="#FFB00020" Click="Close_Click" />
                    </UniformGrid>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- La boutique de récompenses (surcouche plein écran, remplie en code) -->
        <Grid x:Name="ShopHost" Visibility="Collapsed" />

        <!-- 📒 Mon carnet (surcouche plein écran, remplie en code) -->
        <Grid x:Name="BookHost" Visibility="Collapsed" />

        <!-- 🙋 Je choisis (surcouche plein écran, remplie en code) -->
        <Grid x:Name="ChoiceHost" Visibility="Collapsed" />

        <!-- ⏱ La pause proposée (surcouche, remplie en code) -->
        <Grid x:Name="PauseHost" Visibility="Collapsed" />

        <!-- Cercle de progression du dwell (au-dessus de tout, non cliquable) -->
        <Canvas x:Name="GazeLayer" IsHitTestVisible="False">
            <!-- Point de regard toujours visible : l'enfant voit où il regarde. -->
            <Ellipse x:Name="GazeDot" Width="38" Height="38" Visibility="Collapsed"
                     Fill="#88FF3D7F" Stroke="White" StrokeThickness="3" />
            <Grid x:Name="GazeIndicator" Width="90" Height="90" Visibility="Collapsed">
                <Ellipse Width="74" Height="74" Stroke="#33512DA8" StrokeThickness="9"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Path x:Name="GazeProgress" Stroke="#FF7E3FF2" StrokeThickness="9"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Width="56" Height="56" Fill="#33FFFFFF"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Canvas>
    </Grid>
</Window>
