<UserControl x:Class="MesPremiersJeux.Views.ColoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#FFFBF3FF">

        <!-- Galerie de dessins (comme la bibliothèque de livres) -->
        <Grid x:Name="MenuRoot">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="Gallery" HorizontalAlignment="Center" Margin="20" />
            </ScrollViewer>
        </Grid>

        <!-- Écran de coloriage (palette à gauche + dessin en grand) -->
        <Grid x:Name="ColorRoot" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Palette complète (gauche) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="10,8">
                <UniformGrid x:Name="PaletteHost" Columns="4" Width="536" />
            </ScrollViewer>

            <!-- Zone de dessin : le dessin occupe toute la hauteur, les boutons
                 retour / outils flottent par-dessus les coins. -->
            <Grid Grid.Column="1" Margin="2,6,8,8">
                <Viewbox Stretch="Uniform">
                    <Border x:Name="StageBorder" Background="White" CornerRadius="12"
                            BorderBrush="#FFE4CCF2" BorderThickness="2">
                        <Image x:Name="Img" Width="800" Height="800" Stretch="Fill"
                               SnapsToDevicePixels="True"
                               MouseLeftButtonDown="Img_MouseLeftButtonDown" />
                    </Border>
                </Viewbox>

                <Button x:Name="BackBtn" Style="{StaticResource BackButton}" Content="🎨  Dessins"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Click="Back_Click" />
                <StackPanel x:Name="TopTools" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
