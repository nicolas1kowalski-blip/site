<UserControl x:Class="MesPremiersJeux.Views.ColoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#FFFBF3FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Palette (gauche) -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="12">
            <UniformGrid x:Name="PaletteHost" Columns="2" Width="242" />
        </ScrollViewer>

        <!-- Grand dessin (centre) -->
        <Viewbox Grid.Column="1" Margin="16" Stretch="Uniform">
            <Border x:Name="StageBorder" Background="White" CornerRadius="18"
                    BorderBrush="#FFE4CCF2" BorderThickness="3">
                <Image x:Name="Img" Width="800" Height="800" Stretch="Fill"
                       SnapsToDevicePixels="True"
                       MouseLeftButtonDown="Img_MouseLeftButtonDown" />
            </Border>
        </Viewbox>

        <!-- Outils (droite) -->
        <StackPanel Grid.Column="2" x:Name="ToolsHost" Width="132" Margin="8,12" />
    </Grid>
</UserControl>
