<UserControl x:Class="MesPremiersJeux.Views.EducationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#FFEFF7FF">

        <!-- Niveau 1 : les THÈMES (grandes tuiles, pas de défilement). -->
        <Grid x:Name="MenuRoot">
            <UniformGrid x:Name="Cats" Columns="3" Margin="16" />
        </Grid>

        <!-- Niveau 2 : les activités du thème choisi (grille plein écran). -->
        <Grid x:Name="ListRoot" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Button x:Name="ThemesBtn" Style="{StaticResource BackButton}" Click="Themes_Click"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,10,0,2"
                        Content="⬅  Thèmes" />
                <TextBlock x:Name="CatTitle" FontSize="36" FontWeight="Bold" Foreground="#FF1F3A5A"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,2" />
            </Grid>
            <UniformGrid x:Name="Menu" Grid.Row="1" Columns="3" Margin="16,4,16,16" />
        </Grid>

        <!-- Activité en cours : plein écran + bouton retour -->
        <Grid x:Name="PlayRoot" Visibility="Collapsed">
            <Grid x:Name="GameHost" />
            <Button x:Name="BackBtn" Style="{StaticResource BackButton}" Click="Back_Click"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Content="⬅  Menu" />
        </Grid>

        <Canvas x:Name="Confetti" IsHitTestVisible="False" ClipToBounds="True" />
    </Grid>
</UserControl>
